{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reader.arturo-kuang/schemas/highlight.schema.json",
  "title": "Highlight payload",
  "description": "HighlightEntry (ReaderCore Models.swift) minus id; md comment key 'note' = noteId.",
  "type": "object",
  "properties": {
    "page": {
      "$ref": "common.schema.json#/$defs/page"
    },
    "cfi": {
      "$ref": "common.schema.json#/$defs/cfi"
    },
    "section": {
      "$ref": "common.schema.json#/$defs/section"
    },
    "quote": {
      "$ref": "common.schema.json#/$defs/quote"
    },
    "prefix": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "suffix": {
      "$ref": "common.schema.json#/$defs/context"
    },
    "color": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "rects": {
      "$ref": "common.schema.json#/$defs/rects"
    },
    "noteId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/recordId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Link of record to a note."
    },
    "extras": {
      "$ref": "common.schema.json#/$defs/extras"
    }
  },
  "required": [
    "color",
    "quote",
    "prefix",
    "suffix",
    "extras"
  ],
  "additionalProperties": false
}
