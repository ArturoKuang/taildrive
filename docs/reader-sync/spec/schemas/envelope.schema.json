{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.reader.arturo-kuang/schemas/envelope.schema.json",
  "title": "Record envelope",
  "description": "Feed entry / stored record. In a push, the server ignores version, deviceId, seq, conflict.",
  "type": "object",
  "properties": {
    "bookId": {
      "$ref": "common.schema.json#/$defs/fingerprint"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/kind"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/recordId"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "baseVersion": {
      "type": "integer",
      "minimum": 0
    },
    "deleted": {
      "type": "boolean"
    },
    "deviceId": {
      "$ref": "common.schema.json#/$defs/deviceId"
    },
    "changeId": {
      "$ref": "common.schema.json#/$defs/changeId"
    },
    "clientTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": [
        "object",
        "null"
      ]
    },
    "conflict": {
      "anyOf": [
        {
          "$ref": "conflict.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "bookId",
    "kind",
    "id",
    "version",
    "deleted",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "book"
          },
          "deleted": {
            "const": false
          }
        },
        "required": [
          "kind",
          "deleted"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "book.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "highlight"
          },
          "deleted": {
            "const": false
          }
        },
        "required": [
          "kind",
          "deleted"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "highlight.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "note"
          },
          "deleted": {
            "const": false
          }
        },
        "required": [
          "kind",
          "deleted"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "note.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "word"
          },
          "deleted": {
            "const": false
          }
        },
        "required": [
          "kind",
          "deleted"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "word.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "lookup"
          },
          "deleted": {
            "const": false
          }
        },
        "required": [
          "kind",
          "deleted"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "lookup.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "position"
          },
          "deleted": {
            "const": false
          }
        },
        "required": [
          "kind",
          "deleted"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "position.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "book"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/fingerprint"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "position"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p_sha256:[0-9a-f]{64}_[^\\u0000-\\u001f\\u007f]+$"
          },
          "deleted": {
            "const": false
          }
        }
      }
    }
  ]
}
